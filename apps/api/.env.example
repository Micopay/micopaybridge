# ─────────────────────────────────────────────────────────────────────────────
# apps/api — configuración de entorno
#
# Copia este archivo a `apps/api/.env` y rellena los valores:
#
#     cp apps/api/.env.example apps/api/.env
#
# `src/config.ts` lo lee a mano (sin dotenv) y SOLO cuando NODE_ENV != production.
# En producción las variables se inyectan por el entorno, no por archivo.
# Una variable ya presente en el entorno NO se sobrescribe con la del archivo.
#
# NUNCA pongas aquí un valor real. Todo lo marcado [SECRETO] firma o mueve
# fondos: si se filtra, se pierden. `.env` está en .gitignore; `.env.example`
# está exceptuado a propósito para poder versionarlo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────

# Puerto HTTP de la API. Opcional (por defecto 3000).
PORT=3000

# development | production. Opcional (por defecto "development").
# En "production": no se lee .env, DEMO_MODE se ignora, y X402_MOCK_MODE o
# ALLOW_CLIENT_ROOTS en "true" abortan el arranque.
NODE_ENV=development

# URL pública de esta API. La usan /skill.md y el catálogo de servicios para
# anunciarse a los agentes. Opcional (routes/agent.ts asume http://localhost:3000
# y routes/services.ts asume https://api.micopay.xyz — pon la tuya y deja de
# depender de cuál de los dos responde).
API_BASE_URL=http://localhost:3000

# Orígenes CORS permitidos, separados por coma. Opcional en desarrollo (se
# permite localhost en 3000/5173/5185). REQUERIDO en producción: vacío
# significa que se rechaza toda petición con Origin.
CORS_ALLOWED_ORIGINS=http://localhost:5185

# "true" activa datos y rutas de demo. Opcional (por defecto false).
# Se ignora si NODE_ENV=production.
DEMO_MODE=false

# "true" habilita las rutas de inversión. Opcional (por defecto false).
# DEMO_MODE=true también las habilita.
ENABLE_INVESTMENTS=false

# "true" permite raíces de Merkle enviadas por el cliente en credenciales ZK.
# Opcional (por defecto false). SOLO para tests: en producción aborta el arranque.
ALLOW_CLIENT_ROOTS=false

# ── Base de datos ────────────────────────────────────────────────────────────

# PostgreSQL. Opcional (por defecto postgresql://localhost:5432/micopay_dev),
# pero sin una base alcanzable el bazaar y la protección de replay de x402
# corren degradados, en memoria.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/micopay_dev

# Timeout de conexión a PostgreSQL, en ms. Opcional (por defecto 5000).
PG_CONNECT_TIMEOUT_MS=5000

# ── Sesión y cifrado ─────────────────────────────────────────────────────────

# [SECRETO] Firma los JWT. Opcional en desarrollo (por defecto "dev_jwt_secret"),
# REQUERIDO en producción — el valor por defecto es público.
JWT_SECRET=cadena_larga_y_aleatoria_cambiar

# Caducidad de los JWT. Opcional (por defecto "24h").
JWT_EXPIRY=24h

# [SECRETO] Cifra los secretos en reposo. REQUERIDO si se guardan claves.
SECRET_ENCRYPTION_KEY=cadena_larga_y_aleatoria_cambiar

# ── Stellar / Soroban ────────────────────────────────────────────────────────

# RPC de Soroban que usa la API. Opcional (por defecto
# https://soroban-testnet.stellar.org).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# RPC de Soroban que usan lib/zkVerify.ts y los CLI de cli/. Opcional
# (mismo valor por defecto).
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# TESTNET | PUBLIC. Opcional (por defecto "TESTNET"). Determina el passphrase
# contra el que se validan las firmas de x402: si no coincide con la red donde
# el agente firmó, todo pago se rechaza.
STELLAR_NETWORK=TESTNET

# [SECRETO] Clave secreta Stellar de la plataforma (empieza por S). Firma la
# pierna iniciadora del swap atómico. REQUERIDO para POST /api/v1/swaps/execute
# y para el lock del bazaar. Fondéala en https://friendbot.stellar.org
PLATFORM_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Dirección pública de la plataforma, la que cobra los pagos x402. Opcional:
# si falta se deriva de PLATFORM_SECRET_KEY, y si esa tampoco está se usa una
# dirección de demo cableada. Si cobras de verdad, ponla explícita.
PLATFORM_STELLAR_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID del contrato de escrow desplegado. REQUERIDO para las rutas de escrow.
ESCROW_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ID del contrato AtomicSwapHTLC (pierna A). Opcional: src/index.ts trae
# cableado un contrato de testnet como valor por defecto.
ATOMIC_SWAP_CONTRACT_A=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Emisor del USDC que se acepta. Opcional (por defecto el emisor de USDC en
# testnet). Se compara junto al código del asset: otro emisor es otro asset,
# y el pago se rechaza.
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# "true" simula las llamadas a Stellar sin tocar la red. Opcional (por defecto
# false). Para tests.
MOCK_STELLAR=false

# Intervalo de sondeo al confirmar transacciones Soroban, en ms. Opcional
# (por defecto 2000).
SOROBAN_POLL_INTERVAL_MS=2000

# ── Agente de demostración ───────────────────────────────────────────────────

# [SECRETO] Clave secreta Stellar de la contraparte de demo. REQUERIDO para el
# swap de demostración de extremo a extremo.
DEMO_AGENT_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Dirección pública del agente de demo. Opcional: hay un placeholder cableado
# (GDEMOAGENT...) que NO es una cuenta real y no puede recibir nada.
DEMO_AGENT_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC que se anuncia como disponible en la contraparte de demo. Opcional
# (por defecto 10000).
DEMO_COUNTERPARTY_AVAILABLE_USDC=10000

# ── MXNe (peso mexicano tokenizado) ──────────────────────────────────────────

# ID del contrato MXNe. Opcional; sin él las rutas de MXNe quedan inactivas.
MXNE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Dirección emisora de MXNe. Opcional, igual que la anterior.
MXNE_ISSUER_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── XRPL ─────────────────────────────────────────────────────────────────────

# WebSocket del nodo XRPL. Opcional (por defecto la testnet altnet).
XRPL_SERVER=wss://s.altnet.rippletest.net:51233

# [SECRETO] Semilla XRPL del iniciador (empieza por s). REQUERIDO para la
# pierna XRPL del swap (EscrowCreate / EscrowFinish).
XRPL_INITIATOR_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [SECRETO] Semilla XRPL de la contraparte. REQUERIDO para la misma pierna.
XRPL_COUNTERPARTY_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── x402 (pago por petición) ─────────────────────────────────────────────────

# Cadenas aceptadas para pagar, separadas por coma: stellar, base.
# Opcional (por defecto "stellar").
X402_ACCEPT_CHAINS=stellar

# "true" acepta cabeceras X-PAYMENT falsas con prefijo "mock:" y NO cobra nada.
# Opcional (por defecto false). Es lo que usan los tests. En producción aborta
# el arranque.
X402_MOCK_MODE=false

# Espera entre reintentos de inicialización de la tabla de replay de x402,
# en ms. Opcional (por defecto 30000).
X402_DB_RETRY_MS=30000

# Facilitador externo que liquida los pagos de Base. Opcional: si está vacío,
# la API envía la transacción ella misma usando RELAYER_EVM_PRIVATE_KEY.
X402_FACILITATOR_URL=

# ── Base (EVM, EIP-3009) ─────────────────────────────────────────────────────

# RPC de Base. Opcional (por defecto https://sepolia.base.org).
BASE_RPC_URL=https://sepolia.base.org

# Chain ID de Base. Opcional (por defecto 84532 = Base Sepolia).
BASE_CHAIN_ID=84532

# Contrato USDC en Base. REQUERIDO si "base" está en X402_ACCEPT_CHAINS.
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Nombre del dominio EIP-712 del USDC. Opcional (por defecto "USDC").
# Solo tócalo si el token declara otro: si no coincide, la firma no valida.
BASE_USDC_NAME=USDC

# Versión del dominio EIP-712 del USDC. Opcional (por defecto "2").
BASE_USDC_VERSION=2

# Dirección de la plataforma en Base, la que recibe los pagos. REQUERIDO si
# "base" está en X402_ACCEPT_CHAINS.
PLATFORM_BASE_ADDRESS=0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [SECRETO] Clave privada EVM que paga el gas al reenviar
# transferWithAuthorization. REQUERIDO para cobrar en Base sin facilitador.
RELAYER_EVM_PRIVATE_KEY=0xXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Credenciales ZK ──────────────────────────────────────────────────────────

# ID del contrato verificador ZK. REQUERIDO para las rutas de credenciales.
ZK_VERIFIER_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [SECRETO] Clave secreta Stellar del administrador del verificador ZK.
# REQUERIDO para publicar raíces y para los CLI de cli/.
ADMIN_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [SECRETO] Clave secreta Stellar del operador que registra las verificaciones.
# Opcional: si falta se usa ADMIN_SECRET_KEY.
OPERATOR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Inferencia (planificación de swaps) ──────────────────────────────────────

# anthropic | ollama. Opcional (por defecto "anthropic").
INFERENCE_PROVIDER=anthropic

# Modelo a usar. Opcional (por defecto claude-haiku-4-5-20251001).
INFERENCE_MODEL=claude-haiku-4-5-20251001

# [SECRETO] API key de Anthropic. REQUERIDO si INFERENCE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [SECRETO] API key de Ollama Cloud. REQUERIDO si INFERENCE_PROVIDER=ollama.
OLLAMA_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo de Ollama. Opcional (por defecto gpt-oss:20b-cloud).
OLLAMA_MODEL=gpt-oss:20b-cloud

# ── Red de efectivo y reputación ─────────────────────────────────────────────

# "true" anuncia la red de efectivo como conectada y habilita sus rutas.
# Opcional (por defecto false).
MICOPAY_CASH_NETWORK_ENABLED=false

# URL del backend de MicoPay del que se lee la reputación real. Opcional:
# sin ella la reputación sale solo de agent_history local.
MICOPAY_BACKEND_URL=

# [SECRETO] Token bearer para ese backend. Opcional, junto con la anterior.
MICOPAY_BACKEND_TOKEN=

# Timeout de esa llamada, en ms. Opcional (por defecto 4000).
MICOPAY_BACKEND_TIMEOUT_MS=4000

# Espera entre reintentos de conexión al leer reputación, en ms. Opcional
# (por defecto 30000, mínimo 1000).
REPUTATION_DB_RETRY_MS=30000

# Timeout de la consulta de reputación, en ms. Opcional (por defecto 1000,
# mínimo 100).
REPUTATION_LOOKUP_TIMEOUT_MS=1000

# Base de las URL de cobro que se entregan al beneficiario en efectivo.
# Opcional (por defecto http://localhost:5181).
CLAIM_BASE_URL=http://localhost:5181

# ── Almacenamiento ───────────────────────────────────────────────────────────

# Directorio donde se persisten swaps y planes, un archivo por registro.
# Opcional (por defecto ./swap-store). Vacío ("") lo desactiva y todo queda en
# memoria: así corren los tests.
SWAP_STORE_DIR=./swap-store

# ── Scripts contra testnet real (src/scripts/, no la API) ────────────────────

# Alias de la identidad iniciadora en la CLI de Stellar. Opcional (por defecto
# "raul-bridge"). Solo lo usa `npm run test:live`.
STELLAR_INITIATOR_ALIAS=raul-bridge

# Alias de la identidad de contraparte. Opcional (por defecto "mota-agent").
STELLAR_COUNTERPARTY_ALIAS=mota-agent
